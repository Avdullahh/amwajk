---
import Layout from '~/layouts/PageLayout.astro';
import BrochureContent from '~/components/BrochureContent.astro';
import { useTranslations } from '~/i18n/utils';

const t = useTranslations('en');
const metadata = {
  title: t('meta.title'),
  description: t('meta.description'),
  ignoreTitleTemplate: true,
  openGraph: {
    images: [{ url: t('meta.image'), width: 1200, height: 630, alt: t('meta.imageAlt') }],
  },
  twitter: { cardType: 'summary_large_image' },
};
---

<Layout metadata={metadata} locale="en">
  <BrochureContent locale="en" />
</Layout>
