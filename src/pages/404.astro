---
import Layout from '~/layouts/Layout.astro';
import { locales } from '~/i18n/ui';
import { getRelativeLocaleUrl, useTranslations } from '~/i18n/utils';

const title = `${useTranslations('ar')('404.title')} / ${useTranslations('en')('404.title')} — 404`;
---

<Layout metadata={{ title }} skipSearchMetadata>
  <main class="flex min-h-screen items-center p-8 md:p-16">
    <div class="container mx-auto my-8 flex max-w-xl flex-col items-center gap-8 text-center">
      <h1 class="text-9xl font-bold text-primary">404</h1>
      {
        locales.map((locale) => {
          const t = useTranslations(locale);
          return (
            <section lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
              <h2 class="text-3xl font-semibold">{t('404.title')}</h2>
              <p class="mb-6 mt-4 text-lg text-muted dark:text-slate-400">{t('404.description')}</p>
              <a href={getRelativeLocaleUrl(locale, '/')} class="btn">
                {t('404.home')}
              </a>
            </section>
          );
        })
      }
    </div>
  </main>
</Layout>
