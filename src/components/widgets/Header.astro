---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-3 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div
      class:list={[
        { 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' },
        'flex justify-between ltr:md:order-last ltr:md:justify-self-end',
      ]}
    >
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center md:hidden">
        <ToggleMenu />
      </div>
    </div>
    <nav
      class="items-center w-full md:w-auto hidden md:flex md:mx-5 text-default overflow-y-auto overflow-x-hidden md:overflow-y-visible md:overflow-x-auto md:justify-self-center"
      aria-label="Main navigation"
    >
      <ul
        class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium md:justify-center"
      >
        {
          links.map(({ text, href, links }) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </button>
                  <ul class="dropdown-menu md:backdrop-blur-md dark:md:bg-dark rounded md:absolute ps-4 md:ps-0 md:hidden font-medium md:bg-white/90 md:min-w-50 drop-shadow-xl">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b md:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
        {
          /* The actions container below is `hidden` under md:, so the language switcher
             simply did not exist on mobile. Repeat it here as a menu item — md:hidden so
             desktop still gets the single button and never shows it twice. */
          actions?.length ? (
            <li class="md:hidden mt-2 border-t border-gray-200 pt-2 dark:border-slate-700">
              {actions.map(({ text, href }) => (
                <a class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center gap-2" href={href}>
                  <Icon name="tabler:language" class="w-5 h-5" />
                  {text}
                </a>
              ))}
            </li>
          ) : (
            ''
          )
        }
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-start left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 ltr:md:order-first ltr:md:justify-self-start rtl:md:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full md:w-auto">
        <div class="flex">
          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}
          {
            showRssFeed && (
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>
        {
          actions?.length ? (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {actions.map((btnProps) => (
                <Button
                  {...btnProps}
                  class="ms-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto !bg-white !text-gray-900 hover:!bg-gray-100 border-0"
                />
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</header>

<style>
  /* ── Scroll-driven ghost → solid header ──────────────────────────────── */
  /* JS sets --header-alpha (0 at top → 1 at 150 px) on #header            */

  /* Background and shadow scale with scroll depth */
  #header {
    background-color: rgba(255, 255, 255, var(--header-alpha, 0));
    backdrop-filter: blur(calc(10px * var(--header-alpha, 0)));
    -webkit-backdrop-filter: blur(calc(10px * var(--header-alpha, 0)));
    box-shadow: 0 1px 8px rgba(0, 0, 0, calc(var(--header-alpha, 0) * 0.08));
  }

  /* Logo: white on transparent header → brand blue on solid white header */
  #header :global(.logo) {
    color: white;
    color: color-mix(in srgb, #244b6e calc(var(--header-alpha, 0) * 100%), white);
  }

  /* Nav text follows hero palette until .scroll flips it */
  #header:not(.scroll) nav,
  #header:not(.scroll) nav a,
  #header:not(.scroll) nav button {
    color: var(--h-text, currentColor);
  }

  /* Scrim fades out as background fades in; hidden on dark hero backgrounds */
  #header > div:first-child {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.2), transparent);
    opacity: calc((1 - var(--header-alpha, 0)) * var(--h-scrim, 1));
  }

  /* 20% height reduction — py-3 (0.75rem) → 0.6rem */
  #header > div:nth-child(2) {
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }

  /* ── Open mobile menu ────────────────────────────────────────────────── */
  /* Everything above is written for a header floating over the hero, and all of it is
     wrong once the header becomes a full-screen menu panel. The scroll-driven rules key
     off --header-alpha, which is 0 at the top of the page — so the panel rendered fully
     transparent with white-on-white text. `.expanded` outranks them all: #header.expanded
     is one class more specific than the bare #header rules, so these win wherever they
     overlap. (BasicScripts also toggles a `bg-page` class, but a plain utility can never
     beat an id selector — that toggle has never had any effect.) */

  #header.expanded {
    background-color: var(--aw-color-bg-page);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* The hero scrim is a dark gradient sized to the header; at 100vh it smears over the
     whole panel. */
  #header.expanded > div:first-child {
    opacity: 0;
  }

  /* --h-text tracks the hero sky and is near-white at night — invisible on the panel. */
  #header.expanded nav,
  #header.expanded nav a,
  #header.expanded nav button {
    color: var(--aw-color-text-default);
  }

  /* Same problem for the logo, which is pure white while --header-alpha is 0. */
  #header.expanded :global(.logo) {
    color: #244b6e;
  }

  /* AstroWind un-hides the actions container on expand, floating it `fixed bottom-0`.
     That duplicates the language switcher already in the nav list and lands it on top of
     the mobile call/WhatsApp bar. Keyed on the breakpoint rather than on `.expanded`:
     BasicScripts' onPageShow drops `expanded` without restoring the `hidden` class, so a
     bfcache restore with the menu open would otherwise leave the button floating there.
     This is the exact complement of Tailwind's `md:`, so desktop keeps its copy. */
  @media not all and (min-width: 48rem) {
    #header > div > div:last-child {
      display: none;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      __headerScrollRegistered?: boolean;
    }
  }

  let headerResizeObserver: ResizeObserver | null = null;

  // Publish the header's real height as --header-h so the hero can sit exactly underneath
  // it. This used to be a hardcoded -76px, but the header measures ~85px at some zoom
  // levels and font metrics, leaving a white band of body background at the top of the
  // page. Measuring removes the guess.
  function publishHeaderHeight(header: HTMLElement) {
    // getBoundingClientRect, not offsetHeight: the latter rounds to whole pixels, and the
    // leftover fraction (85.2 -> 85) is enough to leave a hairline of body background at
    // fractional device-pixel ratios — which is the artifact this exists to remove.
    // Skip while the mobile menu is open. Expanding adds `h-screen`, so measuring then
    // publishes ~100vh and feeds back into two consumers: `#header.expanded nav` uses
    // --header-h as its `top`, which pushed the whole panel below the fold, and the hero's
    // `margin-top: calc(-1 * var(--header-h))` yanked the page up a full viewport. Holding
    // the last collapsed measurement keeps both correct. Measuring the inner bar instead
    // would drop the `border-b` pixel and reintroduce the white band this exists to remove.
    const set = () => {
      if (header.classList.contains('expanded')) return;
      document.documentElement.style.setProperty('--header-h', `${header.getBoundingClientRect().height}px`);
    };
    set();
    headerResizeObserver?.disconnect();
    headerResizeObserver = new ResizeObserver(set);
    headerResizeObserver.observe(header);
  }

  function initHeaderScroll() {
    const header = document.getElementById('header');
    if (!header) return;

    publishHeaderHeight(header);

    let ticking = false;
    const controller = new AbortController();

    function update() {
      const alpha = Math.min(1, window.scrollY / 250);
      header!.style.setProperty('--header-alpha', alpha.toFixed(3));
      ticking = false;
    }

    update();

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true, signal: controller.signal }
    );

    document.addEventListener(
      'astro:before-swap',
      () => {
        controller.abort();
        headerResizeObserver?.disconnect();
        headerResizeObserver = null;
      },
      { once: true }
    );
  }

  if (!window.__headerScrollRegistered) {
    window.__headerScrollRegistered = true;
    document.addEventListener('astro:page-load', initHeaderScroll);
  }

  initHeaderScroll();
</script>
