---
// Shared body of the single-page brochure, rendered once for both locales.
// The thin route files (`/index.astro` AR, `/en/index.astro` EN) each render this
// with their locale; all translatable copy lives in `~/i18n/ui` (`brochure`).
import HeroSection from '~/components/HeroSection.astro';
import CategoryCard from '~/components/CategoryCard.astro';
import BrandStrip from '~/components/BrandStrip.astro';
import OpenStatus from '~/components/OpenStatus.astro';
import WhatsAppIcon from '~/components/WhatsAppIcon.astro';
import Features2 from '~/components/widgets/Features2.astro';
import OrderSteps from '~/components/OrderSteps.astro';
import { business, brochure, type Locale } from '~/i18n/ui';

import toilets from '~/assets/images/categories/toilets.jpg';
import mixersBasins from '~/assets/images/categories/mixers-basins.jpg';
import showers from '~/assets/images/categories/showers.jpg';
import pipesFittings from '~/assets/images/categories/pipes-fittings.jpg';
import waterHeaters from '~/assets/images/categories/water-heaters.jpg';
import accessories from '~/assets/images/categories/accessories.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = brochure[locale];
const mapEmbed = locale === 'ar' ? business.mapEmbedAr : business.mapEmbedEn;

// Images and icons are locale-independent; they pair with the translated items by index,
// so the item order in `~/i18n/ui` must stay identical across locales.
const categoryImages = [toilets, mixersBasins, showers, pipesFittings, waterHeaters, accessories];
const whyUsIcons = ['tabler:tag', 'tabler:user-check', 'tabler:parking'];
const stepIcons = ['tabler:brand-whatsapp', 'tabler:checks', 'tabler:truck-delivery'];

type ContentItem = { title: string; description: string };
// Product cards need chips + alt in BOTH locales. Annotating the map callback with this
// (rather than leaving the parameter implicitly `any`) is what makes `astro check` fail if
// one locale gains a field the other lacks — the drift the `brochure` dict exists to stop.
type ProductItem = ContentItem & { chips: readonly string[]; alt: string };

const whyUsItems = c.whyUs.items.map((item: ContentItem, i: number) => ({ ...item, icon: whyUsIcons[i] }));
const stepItems = c.steps.items.map((item: ContentItem, i: number) => ({ ...item, icon: stepIcons[i] }));
---

<!-- Hero -->
<HeroSection
  title={c.hero.title}
  subtitle={c.hero.subtitle}
  eyebrow={c.hero.eyebrow}
  callLabel={c.hero.call}
  directionsLabel={c.hero.directions}
/>

<!-- What we sell -->
<section id="products" class="px-4 sm:px-6 py-12 md:py-20">
  <div class="mx-auto max-w-6xl">
    <p class="mb-2 text-base font-bold uppercase tracking-wide text-secondary">{c.products.tagline}</p>
    <h2 class="font-heading text-3xl font-bold leading-tighter tracking-tighter md:text-4xl">
      {c.products.title}
    </h2>
    <p class="mt-3 text-lg text-muted">{c.products.subtitle}</p>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        c.products.items.map((item: ProductItem, i: number) => (
          <CategoryCard
            title={item.title}
            chips={item.chips}
            alt={item.alt}
            image={categoryImages[i]}
            ctaLabel={c.products.whatsappCta}
            whatsappTemplate={c.products.whatsappTemplate}
          />
        ))
      }
    </div>
  </div>
</section>

<!-- Brands we stock -->
<BrandStrip locale={locale} id="brands" />

<!-- Why visit -->
<Features2 id="why-us" tagline={c.whyUs.tagline} title={c.whyUs.title} items={whyUsItems} />

<!-- How to order -->
<OrderSteps id="how-to-order" tagline={c.steps.tagline} title={c.steps.title} items={stepItems} />

<!-- Location -->
<section id="location" class="px-4 sm:px-6 py-12 md:py-16">
  <div class="max-w-6xl mx-auto">
    <p class="text-base text-secondary font-bold tracking-wide uppercase mb-2">{c.location.eyebrow}</p>
    <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-8 font-heading">
      {c.location.title}
    </h2>
    <div class="grid md:grid-cols-2 gap-6 md:gap-10 items-start">
      <div class="space-y-4 text-lg text-muted dark:text-slate-300">
        <OpenStatus locale={locale} />
        <p>
          <strong class="text-default">{c.location.addressLabel}</strong><br />{c.location.address}
        </p>
        <p>
          <strong class="text-default">{c.location.hoursLabel}</strong><br />
          {
            c.location.hours.map((line, i) => (
              <Fragment>
                {i > 0 && <br />}
                {line}
              </Fragment>
            ))
          }
        </p>
        <a
          href={business.mapDirections}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 mt-2 px-5 py-3 rounded-md bg-primary text-white font-medium hover:bg-secondary transition"
        >
          {c.location.mapsCta}
        </a>
      </div>
      <div class="rounded-md overflow-hidden border border-gray-200 dark:border-slate-700 aspect-4/3">
        <iframe
          src={mapEmbed}
          width="100%"
          height="100%"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={c.location.mapTitle}></iframe>
      </div>
    </div>
  </div>
</section>

<!-- Contact -->
<section id="contact" class="bg-page-alt px-4 sm:px-6 py-12 md:py-16">
  <div class="mx-auto max-w-5xl">
    <p class="mb-2 text-center text-base font-bold uppercase tracking-wide text-secondary">{c.contact.eyebrow}</p>
    <h2 class="mb-8 text-center font-heading text-3xl font-bold leading-tighter tracking-tighter md:text-4xl">
      {c.contact.title}
    </h2>

    <!-- Three equal cards, side by side from `sm:` up. The WhatsApp card shows the glyph
         rather than the number — the number is already on the Call card beside it. -->
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <a
        href={business.whatsappUrl}
        target="_blank"
        rel="noopener"
        class="flex flex-col items-center justify-center gap-1.5 rounded-xl bg-[#25D366] p-4 text-white transition-opacity hover:opacity-90"
      >
        <span class="text-xs opacity-90">{c.contact.whatsappLabel}</span>
        <WhatsAppIcon size={26} />
      </a>
      <a
        href={business.phoneTel}
        class="flex flex-col items-center justify-center gap-1.5 rounded-xl border border-gray-200 bg-white p-4 transition hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
      >
        <span class="text-xs text-muted">{c.contact.phoneLabel}</span>
        <span class="text-sm font-semibold text-default" dir="ltr">{business.phoneDisplay}</span>
      </a>
      <a
        href={`mailto:${business.email}`}
        class="flex flex-col items-center justify-center gap-1.5 rounded-xl border border-gray-200 bg-white p-4 transition hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
      >
        <span class="text-xs text-muted">{c.contact.emailLabel}</span>
        <span class="text-sm font-semibold text-default" dir="ltr">{business.email}</span>
      </a>
    </div>
  </div>
</section>
