---
// "How to order" — three steps laid out horizontally.
//
// Replaces the AstroWind `Steps` widget, which renders through `ui/Timeline.astro` and is
// vertical by construction. Building this directly also sidesteps Timeline's directional
// `mr-4 rtl:mr-0 rtl:ml-4` pair, so there is nothing here that needs RTL special-casing.
//
// The connector line is inset symmetrically from both edges rather than anchored to one
// side, which makes it direction-agnostic — it looks identical in RTL and LTR.
import { Icon } from 'astro-icon/components';

interface StepItem {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  id?: string;
  tagline: string;
  title: string;
  items: StepItem[];
}

const { id, tagline, title, items } = Astro.props;
---

<section id={id} class="bg-page-alt px-4 py-12 sm:px-6 md:py-16">
  <div class="mx-auto max-w-5xl">
    <p class="mb-2 text-base font-bold uppercase tracking-wide text-secondary">{tagline}</p>
    <h2 class="mb-10 font-heading text-3xl font-bold leading-tighter tracking-tighter md:text-4xl">
      {title}
    </h2>

    <ol class="relative grid grid-cols-3 gap-2 sm:gap-6">
      <!-- Sits behind the markers. Inset by ~1/6 of the row so it starts and ends at the
           outer circles' centres instead of running off the edges. -->
      <div
        class="pointer-events-none absolute inset-x-[16.6%] top-6 hidden h-px bg-gray-300 sm:top-7 sm:block dark:bg-slate-600"
        aria-hidden="true"
      >
      </div>

      {
        items.map((item, i) => (
          <li class="relative flex flex-col items-center text-center">
            <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary bg-page text-primary sm:h-14 sm:w-14">
              <Icon name={item.icon} class="h-5 w-5 sm:h-6 sm:w-6" />
              <span class="step-badge absolute flex h-5 w-5 items-center justify-center rounded-full bg-primary text-[0.65rem] font-bold text-white">
                {i + 1}
              </span>
            </div>

            <h3 class="mt-3 text-xs font-bold leading-snug text-default sm:text-base">{item.title}</h3>
            <p class="mt-1 hidden text-sm leading-relaxed text-muted sm:block">{item.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Tailwind ships no logical-property utility for a negative inline offset, so the badge
     is positioned here. `inset-inline-end` flips on its own in RTL — using `-right-1.5`
     would pin the badge to the same physical side in both locales. */
  .step-badge {
    top: -0.375rem;
    inset-inline-end: -0.375rem;
  }
</style>
