---
// Shared WhatsApp glyph. Used on the category cards and in the contact panel — kept in one
// place so the path can't drift between them.
interface Props {
  size?: number;
  class?: string;
}

// `|| undefined` so an unset class doesn't emit a bare empty `class` attribute.
const { size = 18, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  class={className || undefined}
  aria-hidden="true"
>
