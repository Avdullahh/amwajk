---
import '@fontsource-variable/inter';
// Arabic-capable variable font. Inter has no Arabic glyphs, so Arabic text falls through
// to this. Swap for the design's chosen Arabic family when the new UI lands.
import '@fontsource-variable/cairo';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  /* Brand palette — Amwaj Alkhaleej. Deep blue wave-mark, blue-grey supporting tones.
     See documents/BRANDIDENTITY.md. These vars are the ONLY place colours are defined;
     components read them through the Tailwind theme (tailwind.config.js). */
  :root {
    --aw-font-sans: 'Inter Variable', 'Cairo Variable';
    --aw-font-serif: 'Inter Variable', 'Cairo Variable';
    --aw-font-heading: 'Inter Variable', 'Cairo Variable';

    --aw-color-primary: rgb(30 79 120); /* #1E4F78 deep blue — matches the hero CTA */
    --aw-color-secondary: rgb(67 105 140); /* #43698C muted blue-grey */
    --aw-color-accent: rgb(157 184 204); /* #9DB8CC light blue-grey */

    --aw-color-text-heading: rgb(16 42 67); /* #102A43 near-navy */
    --aw-color-text-default: rgb(36 59 83); /* #243B53 */
    --aw-color-text-muted: rgb(36 59 83 / 66%);
    --aw-color-bg-page: rgb(255 255 255);
    --aw-color-bg-alt: rgb(245 248 250); /* #F5F8FA off-white section band */

    --aw-color-bg-page-dark: rgb(11 27 43);

    ::selection {
      background-color: rgb(157 184 204 / 45%);
    }
  }

  /* Arabic leads with Cairo. Inter carries no Arabic glyphs, so listing it first only
     works by fall-through; naming Cairo first makes the choice deliberate and keeps
     Latin text inside Arabic pages (phone numbers, brand names) on Inter. */
  [lang='ar'] {
    --aw-font-sans: 'Cairo Variable', 'Inter Variable';
    --aw-font-serif: 'Cairo Variable', 'Inter Variable';
    --aw-font-heading: 'Cairo Variable', 'Inter Variable';
  }

  /* Colours only — the font vars are intentionally NOT repeated here. `.dark` and
     [lang='ar'] have equal specificity, so redeclaring fonts below would beat the
     Arabic stack on dark-mode Arabic pages. */
  .dark {
    --aw-color-primary: rgb(111 163 206); /* lightened for contrast on navy */
    --aw-color-secondary: rgb(157 184 204);
    --aw-color-accent: rgb(157 184 204);

    --aw-color-text-heading: rgb(240 246 250);
    --aw-color-text-default: rgb(224 235 243);
    --aw-color-text-muted: rgb(224 235 243 / 66%);
    --aw-color-bg-page: rgb(11 27 43);
    --aw-color-bg-alt: rgb(17 38 58);

    ::selection {
      background-color: rgb(30 79 120);
      color: snow;
    }
  }
</style>
